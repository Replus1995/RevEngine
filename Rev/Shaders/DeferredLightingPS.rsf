#include "/Engine/Shaders/Core/Light.rsh"
#include "/Engine/Shaders/Core/Shadow.rsh"
cbuffer SceneUB : register(b0) { FSceneUniform uScene; };
cbuffer LightUB : register(b2) { FDirectionalLightUniform uDirectionalLight; };
cbuffer ShadowUB : register(b4) { FDirectionalShadowUniform uShadow; };
struct FDeferredDebugUniform { uint Mode; float3 Padding; };
cbuffer DeferredDebugUB : register(b5) { FDeferredDebugUniform uDebug; };

SAMPLER2D(sGBufferA, 5);
SAMPLER2D(sGBufferB, 6);
SAMPLER2D(sGBufferC, 7);
SAMPLER2D(sSceneDepth, 8);
SAMPLER2DARRAY_CMP(sDirectionalShadow, 10);

struct PSInput { float4 Position : SV_POSITION; };
struct PSOutput { float4 Color : SV_Target; };
float2 ScreenUV(float4 Pixel) { return Pixel.xy / float2(uScene.ViewExtent.Width, uScene.ViewExtent.Height); }

float ShadowVisibility(float3 WorldPos, uint Cascade)
{
    float4 ShadowH = mul(uShadow.LightViewProjMats[Cascade], float4(WorldPos, 1.0));
    float3 ShadowCoord = ShadowH.xyz / max(abs(ShadowH.w), EPSILON);
    float2 UV = ShadowCoord.xy * 0.5 + 0.5;
    if (any(UV < 0.0) || any(UV > 1.0) || ShadowCoord.z < 0.0 || ShadowCoord.z > 1.0) return 1.0;
    float Sum = 0.0; const float Texel = uShadow.Params.y;
    [unroll] for (int Y = -1; Y <= 1; ++Y)
        [unroll] for (int X = -1; X <= 1; ++X)
            Sum += sDirectionalShadowTexture.SampleCmpLevelZero(sDirectionalShadowSampler, float3(UV + float2(X, Y) * Texel, Cascade), ShadowCoord.z - uShadow.Params.w);
    return Sum / 9.0;
}

float DirectionalShadow(float3 WorldPos)
{
    const uint Count = (uint)uShadow.Params.x;
    if (Count == 0) return 1.0;
    const float ViewDepth = -mul(uScene.ViewMat, float4(WorldPos, 1.0)).z;
    uint Cascade = Count - 1;
    [unroll] for (uint Index = 0; Index < REV_MAX_CSM_CASCADES; ++Index) if (Index < Count && ViewDepth <= uShadow.CascadeSplits[Index]) { Cascade = Index; break; }
    float Visibility = ShadowVisibility(WorldPos, Cascade);
    if (Cascade + 1 < Count)
    {
        const float Start = uShadow.CascadeSplits[Cascade] * (1.0 - uShadow.Params.z);
        const float Blend = saturate((ViewDepth - Start) / max(uShadow.CascadeSplits[Cascade] - Start, EPSILON));
        Visibility = lerp(Visibility, ShadowVisibility(WorldPos, Cascade + 1), Blend);
    }
    return Visibility;
}

PSOutput main(PSInput Input)
{
    float2 UV = ScreenUV(Input.Position);
    float4 A = sGBufferA.Sample(UV);
    float4 B = sGBufferB.Sample(UV);
    float4 C = sGBufferC.Sample(UV);
    float Depth = sSceneDepth.Sample(UV).r;
    float4 Clip = float4(UV * 2.0 - 1.0, Depth, 1.0);
    float4 WorldH = mul(uScene.InvViewProjMat, Clip);
    float3 WorldPos = WorldH.xyz / max(abs(WorldH.w), EPSILON);
    float3 Normal = normalize(B.xyz);
    float3 ViewDir = normalize(uScene.ViewPos.xyz - WorldPos);
    float3 F0 = lerp(kDielectric, A.rgb, C.a);
    float NdV = max(dot(Normal, ViewDir), 0.0);
    float3 Lighting = 0.0;
    for (uint I = 0; I < uDirectionalLight.Count; ++I)
    {
        float3 L = -uDirectionalLight.Lights[I].Direction.xyz;
        float Visibility = uDirectionalLight.Lights[I].ShadowIndex == 0 ? DirectionalShadow(WorldPos) : 1.0;
        Lighting += ComputeLightPBR(A.rgb, B.a, C.a, Normal, ViewDir, L, NdV, F0, uDirectionalLight.Lights[I].Intensity) * uDirectionalLight.Lights[I].Color.rgb * Visibility;
    }
    float3 Final = kAmbientFactor * A.rgb * A.a + Lighting + C.rgb;
    if (uDebug.Mode == 1) Final = A.rgb;
    else if (uDebug.Mode == 2) Final = Normal * 0.5 + 0.5;
    else if (uDebug.Mode == 3) Final = B.aaa;
    else if (uDebug.Mode == 4) Final = C.aaa;
    else if (uDebug.Mode == 5) Final = A.aaa;
    else if (uDebug.Mode == 6) Final = C.rgb;
    else if (uDebug.Mode == 7) Final = Depth.xxx;
	else if (uDebug.Mode == 8)
	{
		float ViewDepth = -mul(uScene.ViewMat, float4(WorldPos, 1.0)).z;
		uint Cascade = 0;
		[unroll] for (uint I = 0; I < (uint)uShadow.Params.x; ++I) if (ViewDepth > uShadow.CascadeSplits[I]) Cascade = min(I + 1, (uint)uShadow.Params.x - 1);
		const float3 Colors[4] = { float3(1, 0.2, 0.2), float3(0.2, 1, 0.2), float3(0.2, 0.4, 1), float3(1, 0.9, 0.2) };
		Final = (uint)uShadow.Params.x == 0 ? float3(0) : Colors[Cascade];
	}
    PSOutput Result; Result.Color = float4(Final, 1.0); return Result;
}
