#include "/Engine/Shaders/Core/Base.rsh"
struct FShadowPassUniform { float4x4 LightViewProjMat; };
cbuffer ShadowUB : register(b4) { FShadowPassUniform uShadow; };
cbuffer StaticMeshUB : register(b1) { FStaticMeshUniform uStaticMesh; };
struct VSInput { float4 aPosition : POSITION0; uint aColor : COLOR0; float4 aNormal : NORMAL; float4 aTangent : TANGENT; float4 aTexCoord0 : TEXCOORD0; };
struct VSOutput { float4 Position : SV_POSITION; };
VSOutput main(VSInput Input) { VSOutput Result; Result.Position = mul(uShadow.LightViewProjMat, mul(uStaticMesh.ModelMat, Input.aPosition)); return Result; }
